# Copie para .env (uso local) ou cadastre estas variáveis no painel da hospedagem.

# Obrigatória. Crie em https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Recomendada se o site for público: quem usar a IA precisa digitar este código.
ACCESS_CODE=

# Opcionais
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_TOKENS=16000
RATE_LIMIT_PER_HOUR=40
